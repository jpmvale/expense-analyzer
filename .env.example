# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` na raiz do repositório: cp .env.example .env
# Os três apps (api, web, extractor) leem deste único arquivo.
# ---------------------------------------------------------------------------

# --- Banco de dados ---------------------------------------------------------
# Padrão: MongoDB local do `docker compose up -d`. O nome do banco vai na URI
# (`/credit-card`) — é dele que a API e o extractor leem/escrevem.
MONGO_URI=mongodb://localhost:27017/credit-card

# Usando MongoDB Atlas em vez do container local, troque pela sua connection
# string (Atlas → Database → Connect → Drivers). Lembre do nome do banco no fim:
# MONGO_URI=mongodb+srv://<user>:<senha>@<cluster>.mongodb.net/credit-card?retryWrites=true&w=majority

# --- API (apps/api) ---------------------------------------------------------
PORT=3000

# Origens liberadas no CORS, separadas por vírgula. Vazio = libera todas (dev).
CORS_ORIGIN=http://localhost:5173

# --- Autenticação (apps/api) -------------------------------------------------
# As contas vivem na coleção `users` do Mongo e nascem pela tela de cadastro.
# O que fica aqui são as duas decisões que não são de usuário nenhum.

# Quem pode criar conta: só quem souber este código. A instância fica exposta na
# internet, e sem barreira qualquer robô que ache a URL cria conta e sobe CSV.
# Gere com `openssl rand -hex 16` e combine com quem você quer que entre.
INVITE_CODE=troque-por-um-codigo-de-convite

# A conta dona da instância — a única para quem a sincronização com o Google
# Drive existe, porque as credenciais do Drive abaixo são de uma conta Google só.
# As demais contas importam as faturas em CSV pela tela de Importar.
OWNER_USERNAME=troque-por-um-usuario

# Só para a migração da versão de usuário único: `migrate:multiuser` lê estes
# dois para criar a conta dona com o mesmo login que você já usava, sem trocar a
# senha. Depois de migrar, podem sair daqui.
#   pnpm --filter @expense/api hash-password '<sua senha>'
AUTH_USERNAME=troque-por-um-usuario
AUTH_PASSWORD_HASH=troque-pelo-hash-gerado-acima

# Assina o cookie de sessão. Qualquer string longa e aleatória serve — gere com
# `openssl rand -hex 32`. Trocar este valor derruba toda sessão aberta.
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# --- Web (apps/web) ---------------------------------------------------------
# Precisa do prefixo VITE_ para o Vite expor a variável ao bundle do browser.
VITE_API_URL=http://localhost:3000

# --- Extractor (apps/extractor) ---------------------------------------------
# Lê as faturas em CSV e grava no Mongo. Duas fontes possíveis:
#
#   drive  (padrão) — baixa os CSVs do seu Google Drive
#   local           — lê os CSVs de um diretório da sua máquina
EXTRACTOR_SOURCE=drive

# Fonte `local`: diretório com os CSVs (relativo à raiz do repo ou absoluto).
# Os arquivos precisam seguir o padrão `nubank-<ano>-<mês>.csv`, ex.: nubank-2024-03.csv
BILLS_DIR=./bills

# Fonte `drive`: filtro de busca do Google Drive (sintaxe da Drive API v3).
DRIVE_FILE_QUERY=name contains 'nubank'

# Fonte `drive`: caminho do OAuth client baixado do Google Cloud Console e do
# token gerado no primeiro login. Ambos são segredos — já estão no .gitignore.
GOOGLE_CREDENTIALS_PATH=./apps/extractor/drive-credentials.json
GOOGLE_TOKEN_PATH=./apps/extractor/token.json
